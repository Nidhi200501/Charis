PORT=4000
FRONTEND_URL=http://localhost:3000
# For deployed environments you can list multiple origins separated by commas, e.g.:
# FRONTEND_URL=https://charis-np.vercel.app,https://preview-url.vercel.app

# PostgreSQL created through pgAdmin
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/charis

# Open-source LLM provider. Examples:
#   Ollama (self-hosted):            http://127.0.0.1:11434/api/chat
#   Groq (free tier):                https://api.groq.com/openai/v1/chat/completions
#   Hugging Face Inference Providers: https://router.huggingface.co/v1/chat/completions
#   Cloudflare Workers AI:           https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1/chat/completions
#   OpenRouter:                      https://openrouter.ai/api/v1/chat/completions
CHARIS_LLM_URL=http://127.0.0.1:11434/api/chat
CHARIS_LLM_MODEL=qwen2.5:3b
CHARIS_LLM_API_KEY=
